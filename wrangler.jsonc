{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typeignite-server",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomCoordinator"]
    }
  ]
}
